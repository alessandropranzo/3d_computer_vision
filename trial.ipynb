    "def plot_3d_representation(dir_path, subsample_thr=100_000, plot_traj=True):\n",
    "    full_pcd_path = os.path.join(dir_path, \"scene_representation.ply\")\n",
    "    full_traj_path = os.path.join(dir_path, \"camera_trajectory.npy\")\n",
    "\n",
    "    pcd = o3d.io.read_point_cloud(full_pcd_path)\n",
    "    print(pcd)\n",
    "\n",
    "    traj = np.load(full_traj_path)\n",
    "\n",
    "    points_3d = np.asarray(pcd.points)\n",
    "    colors = np.asarray(pcd.colors)\n",
    "\n",
    "    if len(points_3d) > subsample_thr:\n",
    "        indices = np.random.choice(len(points_3d), subsample_thr, replace=False)\n",
    "        points_3d = points_3d[indices]\n",
    "        if colors is not None:\n",
    "            colors = colors[indices]\n",
    "        print(f\"Subsampling the plot to {subsample_thr} points\")\n",
    "\n",
    "    data_list = [go.Scatter3d(\n",
    "        x=points_3d[:, 0], \n",
    "        y=points_3d[:, 1], \n",
    "        z=points_3d[:, 2],\n",
    "        mode='markers',\n",
    "        marker=dict(\n",
    "            size=1.5,\n",
    "            color=colors,\n",
    "            opacity=1.0\n",
    "        )\n",
    "    )]\n",
    "\n",
    "    if plot_traj:\n",
    "        data_list.append(\n",
    "            go.Scatter3d(\n",
    "                x=traj[:, 0],\n",
    "                y=traj[:, 1],\n",
    "                z=traj[:, 2],\n",
    "                mode='lines+markers',\n",
    "                marker=dict(size=4, color='red'),\n",
    "                line=dict(color='red', width=2),\n",
    "                name='Camera Trajectory'\n",
    "            )\n",
    "        )\n",
    "\n",
    "    fig = go.Figure(data=data_list)\n",
    "\n",
    "    fig.update_layout(scene=dict(aspectmode='data'), margin=dict(l=0, r=0, b=0, t=0))\n",
    "    fig.show()"
   ]
