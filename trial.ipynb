    "import os\n",
    "\n",
    "\n",
    "# Path to the images directory\n",
    "images_dir = \"/users/eleves-b/2024/alessandro.pranzo/3d_cv_project/3d_computer_vision/data/my_room/images\"\n",
    "\n",
    "# List all files in the directory and filter for .jpg files whose names are multiples of 10\n",
    "image_files = sorted(\n",
    "    [f for f in os.listdir(images_dir) if f.endswith('.jpg')]\n",
    ")\n",
    "\n",
    "# Extract names with integer part multiple of 10\n",
    "multiple_of_10_files = [images_dir + \"/\" + fname for fname in image_files if int(os.path.splitext(fname)[0]) % 10 == 0]\n",
    "\n",
    "print(\"Files with numbers multiple of 10:\", multiple_of_10_files)"
